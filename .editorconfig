root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# PSR-12: 4 spaces, never tabs
[*.php]
indent_style = space
indent_size = 4

[*.{json,neon}]
indent_style = space
indent_size = 4

# 2, which is what GitHub Actions workflows are written in everywhere
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
