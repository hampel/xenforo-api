# Copy to .env beside the package. Never commit the real file - .gitignore covers it.

# The forum's board URL or its API URL; either works.
XENFORO_URL=https://forum.example.com

# An API key created in the forum's admin panel under Setup > API keys.
XENFORO_API_KEY=

# Optional. A super-user key acts as a guest unless told which user to act as, and most
# read endpoints are more interesting acting as a real member.
#XENFORO_API_USER=1

# Optional, read.php: which forum to read. Defaults to the first Forum node found.
#XENFORO_NODE_ID=2

# Optional, pagination.php: probe a different list endpoint - an add-on's, for instance.
#XENFORO_PAGINATION_PATH=users/
#XENFORO_PAGINATION_KEY=users

# encoding.php sends four requests to a real forum. None of them write anything, but a
# rejected login is still a login attempt, so it is opt-in.
#XENFORO_PROBE=1

# XENFORO_AGENT_MAY_PROBE belongs on the command line for one run and never in this file.
# A persisted one would hand an agent an authorisation nobody made for that run.
