# Copy to .env beside the package. Never commit the real file - .gitignore covers it.

# The forum's board URL or its API URL; either works.
XENFORO_URL=https://forum.example.com

# An API key created in the forum's admin panel under Setup > API keys.
XENFORO_API_KEY=

# Optional. A super-user key acts as a guest unless told which user to act as, and most
# read endpoints are more interesting acting as a real member.
#XENFORO_API_USER=1

# Optional, read.php: which forum to read. Defaults to the first Forum node found.
#XENFORO_NODE_ID=2

# Optional, pagination.php: probe a different list endpoint - an add-on's, for instance.
# The default is threads/, which every forum allows; users/ needs the member list enabled.
#XENFORO_PAGINATION_PATH=users/
#XENFORO_PAGINATION_KEY=users

# encoding.php sends six requests to a real forum: four login attempts that cannot
# succeed, and an attachment it uploads and then deletes through the header under test.
# Nothing pre-existing is touched, but it writes, so it is opt-in. Needs a key that may
# manage attachments, acting as a real user - XENFORO_API_USER above.
#XENFORO_PROBE=1

# upload.php uploads two files to a real forum and deletes them again. Unlike encoding.php
# this one genuinely writes, so it has its own switch rather than sharing XENFORO_PROBE.
# The key must be allowed to manage attachments and must be acting as a real user - set
# XENFORO_API_USER above if the key is a super-user one.
#XENFORO_UPLOAD=1

# write.php creates a thread, replies, a reaction and an edit, and LEAVES them. With
# XENFORO_WRITE_USER=1 it also creates a user, who posts the replies. XENFORO_WRITE_THREADS
# seeds that many threads, which is how a fresh forum gets a second page for pagination.php.
# It never deletes anything. Development forums only.
#XENFORO_WRITE=1
#XENFORO_WRITE_USER=1
#XENFORO_WRITE_THREADS=25

# XENFORO_AGENT_MAY_PROBE, XENFORO_AGENT_MAY_UPLOAD and XENFORO_AGENT_MAY_WRITE belong on
# the command line for one run and never in this file. A persisted one would hand an agent
# an authorisation nobody made for that run.
